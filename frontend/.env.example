# DeadlineStake frontend configuration.
#
# The deployed Studionet contract address is hard-coded as the default, so the
# app works out of the box. Set this only to point the app at a different
# deployment (e.g. your own). It must be a 0x-prefixed 40-hex-digit address.
#
# NEVER put a private key here. Anything prefixed VITE_ is bundled into the
# shipped JavaScript and would be public. The user's wallet signs every write.
VITE_CONTRACT_ADDRESS=0x3103A13CcCbE7262c7e4D712800A4bb27a0655a2
